# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# LLM Model Configuration
LLM_MODEL=gpt-4
EMBEDDING_MODEL=text-embedding-ada-002

# Optimization Configuration
OPTIMIZATION_MAX_ITERATIONS=10
OPTIMIZATION_THRESHOLD=0.8
OPTIMIZATION_IMPROVEMENT_THRESHOLD=0.01
OPTIMIZATION_EARLY_STOPPING_PATIENCE=3

# Performance Configuration
ENABLE_CACHING=true
ENABLE_PROFILING=false

# Evaluation Configuration
EVALUATION_BOUNDARY_CLARITY_WEIGHT=0.3
EVALUATION_CHUNK_STICKINESS_WEIGHT=0.3
EVALUATION_HOPE_WEIGHT=0.4
